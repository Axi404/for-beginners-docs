---
interface Props {
  title?: string;
  items: string[];
  id?: string;
}

const { title = 'Checklist for moving on', items, id } = Astro.props;
// 使用 id 或根据 title + items 生成唯一标识
const storageKey = id || `checklist-${Buffer.from(title + items.join('')).toString('base64').slice(0, 16)}`;
---

<div class="checklist-card" data-checklist-key={storageKey}>
  <h4 class="checklist-title">{title}</h4>
  <ul class="checklist-items">
    {items.map((item, index) => (
      <li class="checklist-item">
        <label>
          <input type="checkbox" data-index={index} />
          <span>{item}</span>
        </label>
      </li>
    ))}
  </ul>
</div>

<script>
  function initChecklists() {
    document.querySelectorAll('.checklist-card[data-checklist-key]').forEach((card) => {
      const key = card.getAttribute('data-checklist-key');
      if (!key) return;

      const checkboxes = card.querySelectorAll('input[type="checkbox"]');

      // 从 localStorage 恢复状态
      const saved = localStorage.getItem(key);
      if (saved) {
        try {
          const states = JSON.parse(saved);
          checkboxes.forEach((cb, i) => {
            if (states[i]) (cb as HTMLInputElement).checked = true;
          });
        } catch (e) {}
      }

      // 监听变化并保存
      checkboxes.forEach((cb) => {
        cb.addEventListener('change', () => {
          const states: boolean[] = [];
          checkboxes.forEach((c) => states.push((c as HTMLInputElement).checked));
          localStorage.setItem(key, JSON.stringify(states));
        });
      });
    });
  }

  // 初始化
  initChecklists();
  // Astro View Transitions 支持
  document.addEventListener('astro:page-load', initChecklists);
</script>

<style>
  .checklist-card {
    background-color: #d4edda;
    border: 1px solid #28a745;
    border-left: 4px solid #28a745;
    border-radius: 4px;
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
  }

  .checklist-title {
    color: #155724;
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.75rem 0;
  }

  .checklist-items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .checklist-item {
    margin: 0.5rem 0;
  }

  .checklist-item label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    color: #155724;
  }

  .checklist-item input[type="checkbox"] {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: #28a745;
    cursor: pointer;
    flex-shrink: 0;
  }

  .checklist-item span {
    line-height: 1.4;
  }

  /* 深色模式支持 */
  :global([data-theme="dark"]) .checklist-card {
    background-color: rgba(40, 167, 69, 0.15);
    border-color: #28a745;
  }

  :global([data-theme="dark"]) .checklist-title,
  :global([data-theme="dark"]) .checklist-item label {
    color: #90ee90;
  }
</style>
